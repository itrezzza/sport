rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidChatMessage(data, roomId) {
      return data.roomId is string &&
             data.roomId == roomId &&
             isValidId(data.roomId) &&
             data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.senderName is string &&
             data.senderName.size() >= 1 &&
             data.senderName.size() <= 60 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.text is string &&
             data.text.size() >= 1 &&
             data.text.size() <= 300 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /match_rooms/{roomId}/messages/{messageId} {
      allow get: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
      allow list: if isSignedIn() && isValidId(roomId);

      allow create: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidId(messageId) &&
                       incoming().keys().hasAll(['roomId', 'userId', 'senderName', 'text', 'createdAt']) &&
                       incoming().keys().hasOnly(['roomId', 'userId', 'senderName', 'photoUrl', 'text', 'createdAt']) &&
                       isValidChatMessage(incoming(), roomId);

      allow update: if false;

      allow delete: if isSignedIn() &&
                       isValidId(roomId) &&
                       isValidId(messageId) &&
                       existing().userId == request.auth.uid;
    }
  }
}
